load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "codex_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "codex_e2e_benchmark")

codex_rust_crate(
    name = "cli",
    binaries_with_build_commit = ["codex"],
    crate_features = select({
        # Full-fat binary: link the FMSH UKey SDK and enable the real license
        # gate + envelope backends (Cargo feature `ukey`, default off).
        "@platforms//os:linux": ["ukey"],
        "//conditions:default": [],
    }),
    crate_name = "codex_cli",
    # Feature-gated deps: `all_crate_deps()` does not follow crate_features,
    # so list them like v8-poc does for its `sandbox` feature.
    deps_extra = select({
        "@platforms//os:linux": [
            "@crates//:fmsh-ukey-sdk-wrapper",
            "//codex-rs/fm/encrypted-skills:encrypted-skills",
        ],
        "//conditions:default": [],
    }),
    extra_binaries = [
        "//codex-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS + select({
        # Keep the fmsh-ukey SDK resolvable from $ORIGIN/lib on Linux, the
        # same layout build.rs requests for Cargo builds (rules_rust ignores
        # cargo:rustc-link-arg-bins emitted by the build script).
        "@platforms//os:linux": [
            "-C",
            "link-arg=-Wl,-rpath,$$ORIGIN/lib",
        ],
        "//conditions:default": [],
    }),
    test_data_extra = glob(["src/**/snapshots/**"]),
)

multiplatform_binaries(
    name = "grevo",
)

codex_e2e_benchmark(
    name = "codex-help",
    binaries = [":codex"],
)
