load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "codex_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "codex_e2e_benchmark")

codex_rust_crate(
    name = "cli",
    crate_name = "codex_cli",
    extra_binaries = [
        "//codex-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS + select({
        # Keep the fmsh-ukey SDK resolvable from $ORIGIN/lib on Linux, the
        # same layout build.rs requests for Cargo builds (rules_rust ignores
        # cargo:rustc-link-arg-bins emitted by the build script).
        "@platforms//os:linux": [
            "-C",
            "link-arg=-Wl,-rpath,$$ORIGIN/lib",
        ],
        "//conditions:default": [],
    }),
    test_data_extra = glob(["src/**/snapshots/**"]),
)

multiplatform_binaries(
    name = "codex",
)

codex_e2e_benchmark(
    name = "codex-help",
    binaries = [":codex"],
)
