load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "encrypted-skills",
    crate_name = "fm_encrypted_skills",
    crate_features = select({
        # Real envelope backends need the vendored FMSH UKey SDK, which only
        # ships for linux-x86_64-gnu (Cargo feature `ukey`, default off).
        "@platforms//os:linux": ["ukey"],
        "//conditions:default": [],
    }),
    # Feature-gated deps: `all_crate_deps()` does not follow crate_features,
    # so list them like v8-poc does for its `sandbox` feature.
    deps_extra = select({
        "@platforms//os:linux": [
            "@crates//:fmsh-ukey-core",
            "@crates//:fmsh-ukey-skill",
            "@crates//:fmsh-ukey-sdk-wrapper",
        ],
        "//conditions:default": [],
    }),
)
